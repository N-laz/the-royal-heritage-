# ─────────────────────────────────────────────
# DATABASE (Neon PostgreSQL)
# Local setup (db push / seed): use the DIRECT connection string.
# Vercel production: use the POOLED connection string (host contains "-pooler").
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─────────────────────────────────────────────
# AUTH — random string, at least 32 characters
# Generate with: openssl rand -base64 32
# ─────────────────────────────────────────────
AUTH_SECRET="replace-with-a-long-random-secret-of-at-least-32-chars"

# ─────────────────────────────────────────────
# EMAIL (Nodemailer + Gmail SMTP)
# EMAIL_PROVIDER: "smtp" sends real email, "console" only logs emails to the terminal
# SMTP_PASS must be a Gmail App Password (16 characters, no spaces)
# EMAIL_FROM must match SMTP_USER (or a verified Gmail alias)
# ─────────────────────────────────────────────
EMAIL_PROVIDER="smtp"
EMAIL_FROM="The Royal Heritage <kazinomanimtiyaz7656@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="kazinomanimtiyaz7656@gmail.com"
SMTP_PASS="your16charapppassword"

# ─────────────────────────────────────────────
# APP URL — used in email links
# Local: http://localhost:3000   Production: https://your-project.vercel.app
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
